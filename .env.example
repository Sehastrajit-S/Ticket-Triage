# --- Cohere ---
COHERE_API_KEY=your-cohere-api-key
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_EMBED_MODEL=embed-v4.0
COHERE_EMBED_DIM=1536
COHERE_RERANK_MODEL=rerank-v3.5

# --- Cohere via AWS (optional; default provider is "cohere" above, unchanged) ---
# COHERE_PROVIDER=bedrock switches every chat/embed/rerank call to Cohere's own
# BedrockClientV2 instead of the direct API. Needs AWS credentials (aws configure,
# or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars) and Bedrock model access
# enabled for Cohere's models in your AWS account. Unverified against live AWS,
# no AWS account was available while building this.
COHERE_PROVIDER=cohere
AWS_REGION=
COHERE_BEDROCK_CHAT_MODEL=
COHERE_BEDROCK_EMBED_MODEL=
COHERE_BEDROCK_RERANK_MODEL=
# COHERE_PROVIDER=sagemaker uses endpoint names from your own SageMaker deployment instead
COHERE_SAGEMAKER_CHAT_ENDPOINT=
COHERE_SAGEMAKER_EMBED_ENDPOINT=
COHERE_SAGEMAKER_RERANK_ENDPOINT=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://triage:triage@localhost:15432/triage
DATABASE_URL_SYNC=postgresql+psycopg2://triage:triage@localhost:15432/triage

# --- Observability (optional; app runs fine with these unset) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Integrations (stubbed; real credentials plug in later) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ESCALATION_CHANNEL=#support-escalations
NORTH_AUTOMATIONS_WEBHOOK_URL=
NORTH_MCP_TRUSTED_ISSUERS=
NORTH_MCP_PORT=5222

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
RETRIEVAL_TOP_K=25
RERANK_TOP_N=5
