# --- Cohere ---
COHERE_API_KEY=your-cohere-api-key
COHERE_CHAT_MODEL=command-a-03-2025
COHERE_EMBED_MODEL=embed-v4.0
COHERE_EMBED_DIM=1536
COHERE_RERANK_MODEL=rerank-v3.5

# --- Database ---
DATABASE_URL=postgresql+asyncpg://triage:triage@localhost:15432/triage
DATABASE_URL_SYNC=postgresql+psycopg2://triage:triage@localhost:15432/triage

# --- Observability (optional; app runs fine with these unset) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Integrations (stubbed; real credentials plug in later) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ESCALATION_CHANNEL=#support-escalations
NORTH_AUTOMATIONS_WEBHOOK_URL=

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
RETRIEVAL_TOP_K=25
RERANK_TOP_N=5
